# API da Nomus (só leitura). O token é a credencial Basic já em base64.
NOMUS_BASE_URL="https://constelha.nomus.com.br/constelha/rest"
NOMUS_TOKEN=""
NOMUS_TIMEOUT="30000"

# Código de itensPedido[].status que a Nomus usa para "Liberado" (1 = Aguardando liberação, 2 = Liberado).
NOMUS_STATUS_LIBERADO="2"

PORT="3100"

# Banco SQLite. Em produção aponte para uma pasta com VOLUME PERSISTENTE:
# o que o PCP digita (status, atendimento, responsável, ação) só existe aqui.
DATABASE_FILE="data/pcp.sqlite"

# Sincronização automática com a Nomus. Uma varredura leva 10 a 15 min (rate limit deles); o padrão é 1 h.
SYNC_ENABLED="true"
SYNC_INTERVAL_MS="3600000"

# Se preenchido, a tela pede este código e a API recusa quem não o enviar.
# Em produção, DEFINA: a tela mostra nome e telefone de clientes.
ACCESS_TOKEN=""
